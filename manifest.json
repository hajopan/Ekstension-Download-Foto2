{
  "manifest_version": 3,
  "name": "Batch Image Downloader",
  "version": "1.0",
  "description": "Download banyak gambar sekaligus dengan nama kustom.",
  "permissions": [
    "activeTab",
    "scripting",
    "downloads"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}